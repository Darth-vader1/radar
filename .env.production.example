# Production settings for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit .env.production)
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Public address
SITE_ADDRESS=radar.example.com
PUBLIC_ORIGIN=https://radar.example.com
# Your e-mail for Let's Encrypt certificates (or "internal" for a self-signed test cert)
TLS_MODE=ops@example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Secrets (required; the stack refuses to start without them)
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional
# POSTGRES_USER=radar
# POSTGRES_DB=radar
# ALLOW_PUBLIC_REGISTRATION=false
# WEB_CONCURRENCY=2
# WORKER_CONCURRENCY=2
# HTTP_USER_AGENT=RadarBot/1.0 (+https://radar.example.com/bot; bot@radar.example.com)
# IMAGE_TAG=latest

# Source credentials (sources needing these stay "awaiting configuration" until set)
# GOOGLE_PLACES_API_KEY=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
