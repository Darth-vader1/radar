{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d backend && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d frontend && set BACKEND_INTERNAL_URL=http://localhost:8000&& npx next dev -p 3000"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "frontend-running",
      "url": "http://localhost:3000"
    }
  ]
}
