# Environment configuration for RADAR
# Copy to .env and adjust as needed

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="RADAR Web Intelligence Platform"
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start with ENVIRONMENT=production while this placeholder is set.
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_radar_2026_xyz
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Self-service sign-up (always creates standard_user accounts). Unset = on in development,
# off in production. Create administrators with: python -m app.cli create-admin --email you@example.com
# ALLOW_PUBLIC_REGISTRATION=true
# Auth cookie Secure flag. Unset = Secure only when ENVIRONMENT=production (requires HTTPS).
# COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_HOUR=5
# Only set true when the API sits behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=radar_secure_pass
POSTGRES_DB=radar_db
DATABASE_URL=postgresql+asyncpg://radar_user:radar_secure_pass@localhost:5432/radar_db
DATABASE_SYNC_URL=postgresql://radar_user:radar_secure_pass@localhost:5432/radar_db

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend Configuration
# Server-side target for the Next.js /api/v1 proxy (browsers only ever call the frontend origin).
BACKEND_INTERNAL_URL=http://localhost:8000

# Security & SSRF Network Guard
ENFORCE_SSRF_PROTECTION=true
ALLOWED_OUTBOUND_PORTS=80,443
HTTP_USER_AGENT="RadarBot/1.0 (+https://radar-intel.local/bot; bot@radar-intel.local)"
MAX_REDIRECT_HOPS=5
DEFAULT_REQUEST_TIMEOUT=20.0
MAX_RESPONSE_BYTES=5242880

# AI Configuration (Optional for baseline scraping)
AI_ENABLED=false
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# External Service Credentials (Set when deploying specific adapters)
GOOGLE_PLACES_API_KEY=
WEB_SEARCH_API_KEY=
GOOGLE_CSE_ID=
HUNTER_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
EVENTBRITE_PRIVATE_TOKEN=

# SMTP / Email Alerts (Optional in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=alerts@radar-intel.local
